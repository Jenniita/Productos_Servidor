# .env — Variables de entorno del proyecto
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real a git (añade .env al .gitignore).

# ── PostgreSQL ──────────────────────────
DB_NAME=tienda
DB_USER=postgres
DB_PASS=password123

# ── pgAdmin (interfaz web de la BD) ─────
PGADMIN_EMAIL=admin@tienda.com
PGADMIN_PASS=admin123
